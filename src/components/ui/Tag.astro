---
interface Props {
    name: string;
    count?: number;
    size?: "sm" | "md" | "lg";
}

const { name, count, size = "md" } = Astro.props;
import { getLocale, localizedPath } from "../../utils/i18n";
const locale = getLocale(Astro.url.pathname);

const sizeClasses = {
    sm: "text-xs",
    md: "text-sm",
    lg: "text-base",
};
---

<a href={localizedPath(`/tags/${name.toLowerCase()}`, locale)} class={`tag ${sizeClasses[size]}`}>
    #{name}
    {count !== undefined && <span class="opacity-60 ml-1">({count})</span>}
</a>
