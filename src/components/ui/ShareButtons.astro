---
import Icon from "./Icon.astro";
import { getLocale, getTranslations } from "../../utils/i18n";

interface Props {
    title: string;
    url: string;
    description?: string;
}

const { title, url, description } = Astro.props;
const { ui } = getTranslations(getLocale(Astro.url.pathname));

const shareUrls = {
    twitter: `https://twitter.com/intent/tweet?text=${encodeURIComponent(title)}&url=${encodeURIComponent(url)}`,
    facebook: `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(url)}`,
    linkedin: `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(url)}`,
    email: `mailto:?subject=${encodeURIComponent(title)}&body=${encodeURIComponent(url)}`,
};
---

<div class="flex items-center gap-4 mt-8">
    <span class="body-sm font-semibold" style="opacity: 0.75;">{ui.share}</span>
    <div class="flex gap-2">
        <a href={shareUrls.twitter} target="_blank" rel="noopener noreferrer" aria-label={ui.shareOnTwitter} class="icon-btn">
            <Icon name="Twitter" size={24} />
        </a>
        <a href={shareUrls.facebook} target="_blank" rel="noopener noreferrer" aria-label={ui.shareOnFacebook} class="icon-btn">
            <Icon name="Facebook" size={24} />
        </a>
        <a href={shareUrls.linkedin} target="_blank" rel="noopener noreferrer" aria-label={ui.shareOnLinkedIn} class="icon-btn">
            <Icon name="LinkedIn" size={24} />
        </a>
        <a href={shareUrls.email} aria-label={ui.shareByEmail} class="icon-btn">
            <Icon name="Mail" size={24} />
        </a>
    </div>
</div>
