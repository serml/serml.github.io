---
import BaseDetail from "../../layouts/BaseDetail.astro";
import { PAGES } from "../../config";
import { getContentSlug, getLocalizedCollection } from "../../utils/content";

export async function getStaticPaths() {
    if (PAGES.teaching.isActive === false) return [];
    const entries = await getLocalizedCollection("teaching", "es");
    return entries.map((entry) => ({
        params: { id: getContentSlug(entry) },
        props: { entry },
    }));
}

const { entry } = Astro.props;
---

<BaseDetail collection="teaching" id={getContentSlug(entry)} />
