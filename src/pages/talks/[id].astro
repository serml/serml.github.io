---
import BaseDetail from "../../layouts/BaseDetail.astro";
import { PAGES } from "../../config";
import { getContentSlug, getLocalizedCollection } from "../../utils/content";

if (PAGES.talks.isActive === false) {
    return Astro.redirect("/404");
}

export async function getStaticPaths() {
    if (PAGES.talks.isActive === false) return [];
    const talks = await getLocalizedCollection("talks", "es");
    return talks.map((talk: any) => ({
        params: { id: getContentSlug(talk) },
        props: { talk },
    }));
}

const { id } = Astro.params;
---

<BaseDetail collection="talks" id={id} />
