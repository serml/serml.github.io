---
import BaseDetail from "../../layouts/BaseDetail.astro";
import { PAGES } from "../../config";
import { getContentSlug, getLocalizedCollection } from "../../utils/content";

if (PAGES.projects.isActive === false) {
    return Astro.redirect("/404");
}

export async function getStaticPaths() {
    if (PAGES.projects.isActive === false) return [];
    const projects = await getLocalizedCollection("projects", "es");
    return projects.map((project: any) => ({
        params: { id: getContentSlug(project) },
        props: { project },
    }));
}

const { id } = Astro.params;
---

<BaseDetail collection="projects" id={id} />
