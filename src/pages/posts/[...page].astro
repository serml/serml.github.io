---
import BaseListing from "../../layouts/BaseListing.astro";
import { PAGES } from "../../config";
import { getTranslations } from "../../utils/i18n";

const blogPage = getTranslations("es").pages.blog;

if (PAGES.blog.isActive === false) {
    return Astro.redirect("/404");
}

export async function getStaticPaths() {
    if (PAGES.blog.isActive === false) return [];
    return [{
        params: { page: undefined },
        props: { page: { data: [], currentPage: 1, lastPage: 1, url: {} } },
    }];
}

const { page } = Astro.props;
---

<BaseListing
    collection="posts"
    title={blogPage.title}
    subtitle={blogPage.subtitle}
    page={page}
    robots="noindex, follow"
/>
