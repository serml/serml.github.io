---
import { render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getTranslations } from "../utils/i18n";
import { getLocalizedBio } from "../utils/content";

const { pages } = getTranslations("es");

// Load bio content
const bioEntry = await getLocalizedBio("es");
const { Content: BioContent } = bioEntry
	? await render(bioEntry)
	: { Content: null };
---

<BaseLayout title={pages.home.title}>
	<div class="container-narrow">
		{
			(pages.home.title || pages.home.subtitle) && (
				<header class="page-header">
					{pages.home.title && (
						<h1 class="page-title">{pages.home.title}</h1>
					)}
					{pages.home.subtitle && (
						<p class="page-subtitle">{pages.home.subtitle}</p>
					)}
				</header>
			)
		}
		<div class="prose">
			{BioContent ? <BioContent /> : <p>Loading bio...</p>}
		</div>
	</div>
</BaseLayout>
