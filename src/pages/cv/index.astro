---
import { render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Timeline from "../../components/ui/Timeline.astro";
import { PAGES } from "../../config";
import { getTranslations } from "../../utils/i18n";
import { getLocalizedEntry } from "../../utils/content";

const { pages, ui } = getTranslations("es");

if (PAGES.cv.isActive === false) {
    return Astro.redirect("/404");
}

const cvEntry = await getLocalizedEntry("cv", "cv", "es");
if (!cvEntry) {
    throw new Error(
        "CV content not found. Please ensure src/content/cv.md exists.",
    );
}

const { Content } = await render(cvEntry);
const { name, title, experience = [], education = [] } = cvEntry.data;
---

<BaseLayout title={pages.cv.title}>
    <header class="page-header">
        <h1 class="page-title">{pages.cv.title}</h1>
        <p class="page-subtitle">{pages.cv.subtitle}</p>
    </header>

    <div class="container-narrow">
        {
            experience.length > 0 && (
                <section class="section">
                    <h2 class="section-title border-b border-border pb-2">
                        {ui.professionalExperience}
                    </h2>
                    <Timeline items={experience.map(exp => ({
                        title: exp.role,
                        subtitle: exp.institution,
                        period: exp.period,
                        description: exp.description
                    }))} />
                </section>
            )
        }

        {
            education.length > 0 && (
                <section class="section">
                    <h2 class="section-title border-b border-border pb-2">
                        {ui.education}
                    </h2>
                    <Timeline items={education.map(edu => ({
                        title: edu.degree,
                        subtitle: edu.institution,
                        period: edu.period,
                        description: edu.description,
                        thesis: edu.thesis
                    }))} />
                </section>
            )
        }

        <div class="prose max-w-none">
            <Content />
        </div>
    </div>
</BaseLayout>
