---
import BaseDetail from "../../layouts/BaseDetail.astro";
import { PAGES } from "../../config";
import { getContentSlug, getLocalizedCollection } from "../../utils/content";

if (PAGES.publications.isActive === false) {
    return Astro.redirect("/404");
}

export async function getStaticPaths() {
    if (PAGES.publications.isActive === false) return [];
    const publications = await getLocalizedCollection("publications", "es");
    return publications.map((pub: any) => ({
        params: { id: getContentSlug(pub) },
        props: { pub },
    }));
}

const { id } = Astro.params;
---

<BaseDetail collection="publications" id={id} />
